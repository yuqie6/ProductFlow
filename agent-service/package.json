{
  "name": "productflow-agent-service",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "generate-contract-artifacts": "tsx scripts/generate-contract-artifacts.ts",
    "check-contract-artifacts": "tsx scripts/generate-contract-artifacts.ts --check",
    "prebuild": "pnpm run check-contract-artifacts",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "pretest": "pnpm run check-contract-artifacts",
    "test": "vitest run"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "tsx": "4.20.3",
    "typescript": "5.9.3",
    "vitest": "4.1.5"
  }
}
