    "LibraryArchiveOperationV1": {
      "additionalProperties": false,
      "description": "归档可见性；不是删除资产或媒体文件。",
      "properties": {
        "asset_id": {
          "maxLength": 36,
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
