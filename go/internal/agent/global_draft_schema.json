        "expected_revision": {
          "minimum": 1,
          "title": "Expected Revision",
          "type": "integer"
        },
        "before": {
          "$ref": "#/$defs/LibraryAssetBeforeV1"
        },
        "reason": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "operation": {
          "const": "archive",
          "title": "Operation",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/LibraryArchiveTargetV1"
        }
      },
      "required": [
        "asset_id",
        "expected_revision",
        "before",
        "reason",
        "operation",
        "target"
      ],
      "title": "LibraryArchiveOperationV1",
      "type": "object"
    },
    "LibraryArchiveTargetV1": {
      "additionalProperties": false,
