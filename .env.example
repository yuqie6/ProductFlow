# ProductFlow production-style self-hosted example.
# Copy to .env and replace every placeholder before exposing the app.

# Auth (env-only; never commit real values)
ADMIN_ACCESS_KEY=replace-with-a-long-random-admin-key
SETTINGS_ACCESS_TOKEN=replace-with-a-separate-settings-token
SESSION_SECRET=replace-with-another-long-random-session-secret

# App
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=29280
WEB_PORT=29281
APP_HOST_PORT=29280
BACKEND_CORS_ORIGINS=http://localhost:29281,http://127.0.0.1:29281
SESSION_COOKIE_SECURE=false

# Persistence (env-only)
POSTGRES_PASSWORD=replace-with-a-random-postgres-password
POSTGRES_HOST_PORT=15432
DATABASE_URL=postgresql+psycopg://productflow:replace-with-a-random-postgres-password@productflow-postgres:5432/productflow
REDIS_HOST_PORT=16379
REDIS_URL=redis://productflow-redis:6379/0

# Workflow Agent internal service. Use a separate random token with at least 32 characters.
AGENT_SERVICE_INTERNAL_TOKEN=replace-with-a-separate-long-random-agent-token
AGENT_SERVICE_CONNECT_TIMEOUT_SECONDS=5
AGENT_SERVICE_READ_TIMEOUT_SECONDS=90
AGENT_TURN_SYNC_POLL_SECONDS=1
PRODUCTFLOW_REQUEST_TIMEOUT=30s
AGENT_EVENT_POLL_INTERVAL=100ms
AGENT_HEARTBEAT_INTERVAL=15s
AGENT_MAX_ITERATIONS=40
AGENT_MODEL_CONTEXT_WINDOW=128000
AGENT_AUTO_COMPACT_TOKEN_LIMIT=96000
AGENT_MAX_CONCURRENT_TURNS=3

# Agent provider/model settings are configured in the web settings page. The variables below are consumed only by
# `just agent-service-test-live`; the running Agent service ignores them.
PRODUCTFLOW_RUN_LIVE_AGENT=0
AGENT_PROVIDER_API_KEY=
AGENT_PROVIDER_BASE_URL=
AGENT_PROVIDER_MODEL=gpt-5.4
AGENT_PROVIDER_REASONING_EFFORT=
AGENT_PROVIDER_REASONING_SUMMARY=
AGENT_PROVIDER_TEXT_VERBOSITY=
AGENT_PROVIDER_SERVICE_TIER=

# Container runtime storage root stays fixed at /app/storage. To use a host directory instead of the
# default named volume, set STORAGE_HOST_PATH to an absolute host path.
# STORAGE_HOST_PATH=/srv/productflow/storage
# Leave STORAGE_HOST_PATH unset to use the default Docker named volume productflow-storage.
STORAGE_ROOT=/app/storage
# STORAGE_HOST_PATH=

# Prompt, image, and Agent providers are configured in the web settings page after startup.

# Upload safety
UPLOAD_MAX_IMAGE_BYTES=10485760
UPLOAD_MAX_REFERENCE_IMAGES=6
UPLOAD_MAX_PIXELS=16000000
UPLOAD_ALLOWED_IMAGE_MIME_TYPES=image/png,image/jpeg,image/webp

# Jobs
JOB_MAX_ATTEMPTS=3
JOB_RETRY_DELAY_MS=10000
GENERATION_MAX_CONCURRENT_TASKS=3
WORKFLOW_IMAGE_GENERATION_PROVIDER_TIMEOUT_SECONDS=900
